# Token-only setup is the default: compose passes the tunnel token with
# `cloudflared tunnel run --token ...`; no config file is mounted into the
# container. This file documents the ingress routes the named tunnel must have.
#
# One public hostname only. Path prefixes select the origin service:
#   /admin/v1 -> api:8080   /api -> api:8080   / -> web:80
# No /actuator/** route: Prometheus scrapes the management port on the LXC host.
#
# Create/verify the tunnel DNS route from the Cloudflare dashboard or with:
#   cloudflared tunnel route dns <tunnel-uuid> bakery.cherry-home.com
#
# WAF, geo, and admin mTLS are path rules owned by the runbooks:
#   infra/runbooks/cloudflare-tunnel.md
#   infra/runbooks/cloudflare-mtls-ca.md
# WAF guard before mTLS: paths starting `/admin/v1` that contain `;` are
# blocked (403); no extra hostname/ingress, and origin fails closed too.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /root/.cloudflared/REPLACE_WITH_TUNNEL_UUID.json
ingress:
  - hostname: bakery.cherry-home.com
    path: /admin/v1
    service: http://api:8080
  - hostname: bakery.cherry-home.com
    path: /api
    service: http://api:8080
  - hostname: bakery.cherry-home.com
    path: /
    service: http://web:80
  - service: http_status:404
