# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bethanysbakery
DB_USER=bakery
DB_PASSWORD=change-me
DB_POOL_MAX=10
DB_POOL_MIN=1

# Bakery/public config
BAKERY_NAME=Bethany's Bakery
BAKERY_TIMEZONE=America/Denver
BAKERY_PICKUP_ADDRESS=Lehi, Utah
BAKERY_MAPS_URL=https://maps.google.com/?q=Lehi,Utah
BAKERY_SUPPORT_EMAIL=support@example.com
ORDER_CUTOFF_HOURS=12

# Actuator/Prometheus management port. METRICS_BIND_ADDRESS defaults to 0.0.0.0;
# local compose overrides it to 127.0.0.1. Production publishes 0.0.0.0:9090
# behind the host firewall.
METRICS_PORT=9090
METRICS_BIND_ADDRESS=0.0.0.0

# Media uploads (local filesystem backend)
MEDIA_ROOT=/data/media
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_REQUEST_BYTES=11534336
MEDIA_MAX_EDGE_PIXELS=1600
MEDIA_MAX_DECODE_PIXELS=40000000
MEDIA_MAX_SOURCE_EDGE=10000

# Auth crypto (base64, at least 32 bytes). Generate with: openssl rand -base64 32
JWT_SECRET=
APP_ENCRYPTION_KEY=

# Admin device CA (PEM files). Local/test generate an ephemeral CA when unset.
ADMIN_DEVICE_CA_CERT_PATH=
ADMIN_DEVICE_CA_KEY_PATH=

# Cloudflare mTLS forwarding headers
ADMIN_MTLS_HEADER=Cf-Authenticated-Client-Cert
ADMIN_MTLS_VERIFIED_HEADER=Cf-Authenticated-Client-Cert-Verified
# Only honoured with the local or test Spring profile.
ADMIN_MTLS_LOCAL_BYPASS=false

# Session and OTP lifetimes
ADMIN_ACCESS_TTL=PT15M
ADMIN_REFRESH_TTL=P14D
CUSTOMER_ACCESS_TTL=PT15M
CUSTOMER_REFRESH_TTL=P30D
OTP_TTL=PT10M
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_15M=3
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT=PT15M

# Links used by the pairing CLI / admin app. One public hostname in production;
# only the path differs. No hostnames are hardcoded in application code.
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_ADMIN_API_URL=https://localhost:8443
APP_PAIR_URL=https://pair.localhost:8443/pair

# Admin app update metadata
ADMIN_APP_LATEST_VERSION=1.0.0
ADMIN_APP_MIN_VERSION=1.0.0
ADMIN_APP_DOWNLOAD_URL=https://example.com/admin-app.apk
ADMIN_APP_RELEASE_NOTES=

# Payments
VENMO_HANDLE=bethanysbakery
VENMO_DISPLAY_NAME=Bethany's Bakery

# Notifications. Mailgun sends email; Textbee sends SMS through a paired device.
# Admin new-order email goes to ADMIN_ALERT_EMAIL always; optional SMS goes to
# ADMIN_ALERT_PHONE when set. Admin alert destinations are masked in API
# responses and logs; store full values only in the mode-600 .env file.
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=
NOTIFICATION_SCHEDULING_ENABLED=true
NOTIFICATION_OUTBOX_INTERVAL_MS=15000
NOTIFICATION_DISPATCH_INTERVAL_MS=30000
NOTIFICATION_MENU_INTERVAL_MS=60000
ORDER_EXPIRY_INTERVAL_MS=60000
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net/v3
MAILGUN_FROM=
TEXTBEE_BASE_URL=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_WEBHOOK_SECRET=

# Spring
SPRING_PROFILES_ACTIVE=local

# --- Production deployment (single Proxmox LXC) -------------------------------
# Keep the local/dev defaults above unchanged. setup-alpine.sh copies this file
# to /opt/bethanys-bakery/.env and overwrites the values below with strong
# secrets. There is no staging environment, no restic repository, and no
# pg_dump/restore automation: backups are Proxmox full-container backups.

# Cloudflare Tunnel: CLOUDFLARE_PROXY must be true in production so the origin
# checks CF-IPCountry. Leave false for local/dev.
CLOUDFLARE_PROXY=false
CLOUDFLARE_TUNNEL_TOKEN=

# Owner firewall allowlist for tcp/9090. Documentation-only: the app does not
# read this value. Configure ufw/iptables on the LXC before exposing metrics.
# Example: PROMETHEUS_SCRAPE_CIDR=10.10.20.15/32
PROMETHEUS_SCRAPE_CIDR=

# Image tags consumed by infra/compose.prod.yml. WEB_IMAGE is a placeholder
# until W8 ships web/Dockerfile + web/nginx.conf.
API_IMAGE=bethanys-bakery-api:local
WEB_IMAGE=httpd:2.4-alpine
POSTGRES_IMAGE=postgres:16-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# One public hostname; path rules select api or web at the tunnel edge.
# setup-alpine.sh overwrites the APP_* URLs above with these production values:
#   APP_PUBLIC_BASE_URL=https://bakery.cherry-home.com
#   APP_ADMIN_API_URL=https://bakery.cherry-home.com/admin/v1
#   APP_PAIR_URL=https://bakery.cherry-home.com/admin/v1/devices/pair

# Cloudflare-supplied header names. The server reads the canonical Cloudflare
# names; these are documented here for tunnel/WAF configuration.
CF_COUNTRY_HEADER=CF-IPCountry
CF_CONNECTING_IP_HEADER=CF-Connecting-IP
CF_CLIENT_CERT_HEADER=Cf-Authenticated-Client-Cert

# Rate-limit targets. Documentation-only until the production limiter replaces
# the in-memory limiter; the Cloudflare rules in cloudflare-tunnel.md are active.
RATE_OTP_SEND_PER_DESTINATION_15M=3
RATE_OTP_SEND_PER_IP_HOUR=10
RATE_OTP_VERIFY_PER_CHALLENGE=5
RATE_OTP_VERIFY_PER_IP_HOUR=20
RATE_ORDER_CREATE_PER_CUSTOMER_HOUR=10
RATE_ORDER_CREATE_PER_IP_HOUR=30
RATE_CANCEL_PER_CUSTOMER_HOUR=20
RATE_PAIR_PER_IP_15M=10
RATE_ADMIN_LOGIN_PER_IP_15M=10
RATE_MEDIA_UPLOAD_PER_ADMIN_HOUR=20
RATE_MEDIA_GET_PER_IP_MINUTE=120
