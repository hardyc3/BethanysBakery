# Intentionally weak production values for check-env.sh negative-path tests.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=postgres
DB_NAME=bethanysbakery
DB_USER=bakery
DB_PASSWORD=bakery
JWT_SECRET=change-me
APP_ENCRYPTION_KEY=change-me
APP_PUBLIC_BASE_URL=http://bakery.cherry-home.com
APP_ADMIN_API_URL=http://bakery-admin-api.cherry-home.com
APP_PAIR_URL=http://bakery-pair.cherry-home.com
ADMIN_DEVICE_CA_CERT_PATH=/opt/bethanys-bakery/secrets/missing-ca.crt
ADMIN_DEVICE_CA_KEY_PATH=/opt/bethanys-bakery/secrets/missing-ca.key
ADMIN_MTLS_LOCAL_BYPASS=true
OPENAPI_UI_ENABLED=true
CLOUDFLARE_PROXY=true
